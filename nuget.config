<?xml version="1.0" encoding="utf-8"?>
<!-- Pins package restore to nuget.org only, instead of trusting whatever sources happen to be
     configured on the machine doing the restore. Closes off a package silently resolving from
     an unexpected feed (dependency confusion). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
