@* A password input that works without JavaScript: the eye button and the Caps Lock warning start hidden, and password-field.js
   (wwwroot/password-field.js) reveals them. Presentational only - the form that holds it decides what the field means. *@
<div class="wc-password" data-password-field>
    @if (Label is not null)
    {
        <label class="wc-password-label" for="@FieldId">@Label</label>
    }
    <div class="wc-password-control">
        <input id="@FieldId" class="wc-password-input" type="password" name="@Name" autocomplete="@Autocomplete"
               required="@Required" minlength="@MinLength" placeholder="@Placeholder" />
        <button type="button" class="wc-password-toggle" aria-label="Show password" aria-pressed="false" aria-controls="@FieldId" hidden>
            <svg class="wc-password-eye" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M2 12c2.5-4.5 6-7 10-7s7.5 2.5 10 7c-2.5 4.5-6 7-10 7S4.5 16.5 2 12z" />
                <circle cx="12" cy="12" r="3" />
            </svg>
            <svg class="wc-password-eye-off" viewBox="0 0 24 24" aria-hidden="true" focusable="false" hidden>
                <path d="M2 12c2.5-4.5 6-7 10-7s7.5 2.5 10 7c-2.5 4.5-6 7-10 7S4.5 16.5 2 12z" />
                <circle cx="12" cy="12" r="3" />
                <path d="M4 4l16 16" />
            </svg>
        </button>
    </div>
    <div class="wc-password-caps" role="status" aria-live="polite">
        <span class="wc-password-caps-text" hidden>Caps Lock is on</span>
    </div>
</div>

@code {
    /// <summary>The form field name. Handlers read it, so pages keep the name they already post.</summary>
    [Parameter]
    public string Name { get; set; } = "password";

    /// <summary>The input's id. Defaults to one derived from Name so a label can point at it.</summary>
    [Parameter]
    public string? Id { get; set; }

    /// <summary>What the password manager should offer: current-password to sign in, new-password to choose one.</summary>
    [Parameter]
    public string Autocomplete { get; set; } = "current-password";

    /// <summary>Optional label rendered inside the component. Pages that place their own label leave this null.</summary>
    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public bool Required { get; set; }

    [Parameter]
    public int? MinLength { get; set; }

    [Parameter]
    public string? Placeholder { get; set; }

    private string FieldId => Id ?? $"pw-{Name}";
}
